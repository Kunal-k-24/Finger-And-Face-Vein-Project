# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5433/biometric_db
POSTGRES_DB=biometric_db
POSTGRES_USER=user
POSTGRES_PASSWORD=pass

# JWT Security Configuration
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Homomorphic Encryption Configuration (TenSEAL)
HE_POLY_MODULUS_DEGREE=8192

# Differential Privacy Configuration (Opacus)
DP_TARGET_EPSILON=3.0
DP_TARGET_DELTA=1e-5
DP_MAX_GRAD_NORM=1.0

# Federated Learning Configuration (Flower)
FL_SERVER_ADDRESS=localhost:8080
FL_NUM_ROUNDS=10

# Biometric Verification Threshold
SIMILARITY_THRESHOLD=0.75
